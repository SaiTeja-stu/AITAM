<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System-wide protection"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="These permissions let Secure Me warn you about scam SMS, phishing emails and dangerous websites. Every check runs on your device and nothing is uploaded. You can turn any of this off at any time."
            android:textColor="@color/muted" />

        <TextView android:id="@+id/stSms" style="@style/OnbStep" android:text="1 · Allow reading SMS (scan incoming texts)" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSms" style="@style/OnbBtn" android:text="Grant SMS access" />

        <TextView android:id="@+id/stOverlay" style="@style/OnbStep" android:text="2 · Allow drawing over other apps (the warning banner)" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnOverlay" style="@style/OnbBtn" android:text="Open overlay setting" />

        <TextView android:id="@+id/stAccessibility" style="@style/OnbStep" android:text="3 · Turn on the Secure Me accessibility service (dangerous-website warnings in your browser)" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAccessibility" style="@style/OnbBtn" android:text="Open accessibility setting" />

        <TextView android:id="@+id/stNotif" style="@style/OnbStep" android:text="4 · Allow notification access (auto-scan incoming email)" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnNotif" style="@style/OnbBtn" android:text="Open notification-access setting" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="24dp" android:background="@color/edge" />

        <TextView style="@style/OnbStep" android:text="Browser protection" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swWatchBrowsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Warn me when I open a dangerous website in Chrome / any browser"
            android:textColor="@color/text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swStrict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Strict: also stop me on sites Secure Me can't verify (more interruptions)"
            android:textColor="@color/text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:checked="true"
            android:text="Require fingerprint / face unlock to open the app"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Note: on Android 13+ you may first need to allow 'Restricted settings' for this app from its App info screen."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="20dp" android:background="@color/edge" />

        <TextView style="@style/OnbStep" android:text="TRAI DLT &amp; SMS Protection" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swDltProtection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="TRAI DLT Header Verification: validate registered senders &amp; type suffixes (-T, -S, -G)"
            android:textColor="@color/text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swSuppressLegit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Silence false alarms: never flag authentic bank transactions or OTPs as fraud"
            android:textColor="@color/text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swNotifyPromo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="false"
            android:text="Notify on commercial / promotional SMS (-P)"
            android:textColor="@color/text" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="20dp" android:background="@color/edge" />

        <TextView style="@style/OnbStep" android:text="Test the shield" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestLegitSms"
            style="@style/OnbBtn" android:text="▶ Simulate authentic bank alert (VK-HDFCBK-T)" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSms"
            style="@style/OnbBtn" android:text="▶ Simulate fake bank SMS (+91 personal number)" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestEmail"
            style="@style/OnbBtn" android:text="▶ Simulate a phishing email" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Runs the real detection pipeline on sample messages so you can verify that genuine DLT bank alerts stay quiet and fake numbers are flagged."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

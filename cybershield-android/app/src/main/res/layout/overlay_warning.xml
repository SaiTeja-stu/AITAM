<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60B1020"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/ovScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Risk"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ovTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Check before you pay"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ovBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="#E7ECF5"
        android:textSize="15sp" />

    <Button
        android:id="@+id/ovDismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#F87171"
        android:text="Go back — don't pay"
        android:textColor="#0B1020" />

    <Button
        android:id="@+id/ovProceed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#243050"
        android:text="I understand the risk, continue"
        android:textColor="#E7ECF5" />
</LinearLayout>

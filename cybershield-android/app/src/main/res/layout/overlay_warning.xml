<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9060912">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass"
            android:padding="24dp">

            <TextView
                android:id="@+id/ovScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_glass_dim"
                android:text="Risk"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ovTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Check before you continue"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ovBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="#DCE4F1"
                android:textSize="15sp" />

            <Button
                android:id="@+id/ovDismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:backgroundTint="#F87171"
                android:text="Go back — stay safe"
                android:textColor="#0B1020"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ovProceed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/glass_dim"
                android:text="I understand the risk, continue"
                android:textColor="#DCE4F1" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

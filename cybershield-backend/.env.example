# Copy to .env and fill in. run.ps1 loads .env automatically. .env is git-ignored.

# --- required in production ---
CYBERSHIELD_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
CYBERSHIELD_HMAC_SECRET=change-me-to-another-random-string

# --- admin bootstrap (created on first run if user+password set) ---
CYBERSHIELD_ADMIN_USER=admin
CYBERSHIELD_ADMIN_PASSWORD=choose-a-strong-password-min-12-chars
CYBERSHIELD_ADMIN_EMAIL=you@example.com

# --- SMTP (Gmail example) ---
# Gmail needs an App Password (16 chars, no spaces), NOT your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your16charapppassword
MAIL_FROM=your.address@gmail.com

# --- auth behaviour ---
CYBERSHIELD_REQUIRE_EMAIL_VERIFICATION=true
CYBERSHIELD_MAIL_ENABLED=true
CYBERSHIELD_RESET_URL=http://localhost:5173/reset

# --- storage ---
CYBERSHIELD_DB_PATH=./data/cybershield.db
CYBERSHIELD_ARCHIVE_DIR=./data/archive
PORT=8899

# --- optional external services ---
# GOOGLE_SAFE_BROWSING_KEY=
# URLHAUS_AUTH_KEY=
# ANTHROPIC_API_KEY=
